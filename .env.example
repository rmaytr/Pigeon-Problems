# Optional public build-time setting. Vite loads this from .env.local.
# Leave unset for local same-origin HTTP + WebSocket development.
# VITE_SERVER_URL=https://YOUR-WORKER.YOUR-SUBDOMAIN.workers.dev

# PORT is a Node process setting, not loaded from this file by server/local.mjs.
# Set it in your shell when needed. Default: 5173.
# PORT=5173

# CLIENT_ORIGIN belongs in your own Cloudflare Worker variables, not the client.
# Example: https://your-game.example.com
# No credentials are required for local development or CI.
